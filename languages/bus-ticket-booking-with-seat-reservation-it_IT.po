msgid "Optional notes. Shown as an em dash when empty."
msgstr "Note facoltative. Visualizzato come un trattino quando è vuoto."

#: admin/docs/WBTM_Docs_Content.php:231 admin/docs/WBTM_Docs_Content.php:255
#: admin/docs/WBTM_Docs_Content.php:284 admin/docs/WBTM_Docs_Content.php:309
