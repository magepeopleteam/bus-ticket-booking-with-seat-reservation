msgstr "Con quanto anticipo i clienti possono prenotare questo autobus?"

#: admin/docs/WBTM_Docs_Content.php:554
#: admin/settings/WBTM_Date_Settings.php:140
msgid "Off Day"
msgstr "Giorno libero"

#: admin/docs/WBTM_Docs_Content.php:554
msgid "Weekdays the bus never runs."
msgstr "Nei giorni feriali l'autobus non circola mai."

#: admin/docs/WBTM_Docs_Content.php:555
msgid "Excluded Dates"
msgstr "Date escluse"

#: admin/docs/WBTM_Docs_Content.php:555
